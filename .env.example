# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# DayCloser
# LLM for the sales agent (any one provider key works; or connect Builder.io in Settings)
OPENROUTER_API_KEY=
# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# or PAYPAL_CREDENTIALS=CLIENT_ID:SECRET
# Optional: public origin used for PayPal return URLs when behind a proxy
# PUBLIC_APP_URL=https://daycloser.example.com

# Keep agent turns small (8k output tokens is plenty for this agent)
AGENT_MAIN_CHAT_MAX_OUTPUT_TOKENS=8000
AGENT_EMPTY_RESPONSE_RETRY_MAX_OUTPUT_TOKENS=8000
