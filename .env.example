# Persistent PostgreSQL. Use an isolated database for the demo.
DATABASE_URL=postgresql://daycloser:change-me@127.0.0.1:5432/daycloser

# Generate a local secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
APP_URL=http://localhost:3000

# Seed Northlight Studio only when this is 1.
DAYCLOSER_DEMO_MODE=1
# Optional Pacific date in YYYY-MM-DD format. Default is the next weekday.
DAYCLOSER_DEMO_DATE=
# For a deployed demo, set the allowed merchant account's email.
DAYCLOSER_MERCHANT_EMAIL=
# Optional Agent-Native organization scope. Merchant must select it.
DAYCLOSER_STUDIO_ORG_ID=
# Enable the worker on the persistent Node server. Set 0 for a web-only process.
DAYCLOSER_WORKER=1

# OpenAI, Anthropic, or OpenRouter. Set an explicit tool-capable model name.
DAYCLOSER_MODEL_PROVIDER=openai
DAYCLOSER_MODEL=
# Set the matching server-side provider key for both sales automation and chat.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional OpenAI-compatible endpoint, such as http://127.0.0.1:55811/v1 for llama.cpp.
OPENAI_BASE_URL=

# Optional Bryntum Enterprise evaluation key. This browser-side key is public to app visitors.
VITE_BRYNTUM_LICENSE_KEY=

# PayPal Sandbox REST app, sandbox business merchant ID, and registered webhook.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MERCHANT_ID=
PAYPAL_WEBHOOK_ID=
